{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "outDir": "dist",
    "noEmit": false,
    "incremental": false,
    "declaration": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"],
    "plugins": []
  },
  "include": ["index.ts", "host.ts", "setup.ts", "../delegated-mcp/linking.ts"],
  "exclude": ["dist", "node_modules"]
}
