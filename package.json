{
  "name": "thinkarr",
  "version": "1.1.8-beta.12",
  "private": true,
  "scripts": {
    "build:openclaw": "tsc -p connectors/openclaw/tsconfig.build.json",
    "check:openclaw": "node scripts/check-openclaw-sdk.mjs",
    "pack:openclaw": "npm run build:openclaw && node scripts/package-openclaw.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:docker": "playwright test --config playwright.docker.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "security:audit": "node scripts/check-npm-audit.mjs",
    "security:scan": "semgrep --config=p/typescript --config=p/nextjs --config=p/owasp-top-ten src/ connectors/",
    "security:trivy": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image thinkarr:latest",
    "security:all": "npm run security:audit && npm run security:scan"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "langfuse": "^3.39.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "flatted": ">=3.4.2",
    "next": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    },
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": ">=2.0.5"
    },
    "tsconfck": {
      "typescript": "$typescript"
    }
  }
}
